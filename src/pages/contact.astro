---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Start a Project | LaserX Design" description="Contact LaserX Design about autonomous systems, machine design, controls, CAD, fixtures, CNC cutting, welding, or manufacturing integration.">
  <header class="site-header"><div class="container nav"><a class="brand" href="/"><span class="brand-mark">X</span><span class="brand-copy"><strong>LASERX</strong><small>DESIGN</small></span></a><nav class="nav-links"><a href="/solutions">Solutions</a><a href="/#capabilities">Capabilities</a><a href="/projects">Projects</a><a href="/engineering">Engineering</a><a href="/about">About</a><a class="nav-cta" href="/contact">Start a project</a></nav></div></header>
  <main class="inner-page">
    <section class="page-hero"><div class="container"><p class="eyebrow">Start a project</p><h1>Bring the problem. We’ll start with the work.</h1><p class="lede">Tell us what needs to move, improve, repeat, connect, cut, hold, weld, automate, or become a complete system.</p></div></section>
    <section class="section"><div class="container contact-layout"><div class="contact-copy"><p class="eyebrow">Project fit</p><h2>Built for serious manufacturing problems.</h2><p>LaserX Design is a strong fit for custom equipment, autonomous systems, production fixtures, CAD-to-floor implementation, controls integration, CNC machinery, prototypes, and difficult fabrication work.</p><div class="contact-list"><span>Muskegon, Michigan</span><span>Serving West Michigan and select remote projects</span><span>hello@laserxdesign.com</span></div></div><form class="project-form" action="mailto:hello@laserxdesign.com" method="post" enctype="text/plain"><label>Name<input name="name" required /></label><label>Company<input name="company" /></label><label>Email<input name="email" type="email" required /></label><label>Phone<input name="phone" type="tel" /></label><label class="full">Project type<select name="project_type"><option>Autonomous system</option><option>Custom machine</option><option>Controls & integration</option><option>CAD & engineering</option><option>Fixture & tooling</option><option>CNC cutting & fabrication</option><option>Other</option></select></label><label class="full">What needs to be solved?<textarea name="project_details" required></textarea></label><button class="button button-primary" type="submit">Send project inquiry ↗</button></form></div></section>
  </main>
</BaseLayout>
