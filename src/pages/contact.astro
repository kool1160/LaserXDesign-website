---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<BaseLayout title="Start a Project | LaserX Design" description="Contact LaserX Design about autonomous systems, machine design, controls, CAD, fixtures, CNC cutting, welding, or manufacturing integration." image="/images/generated/contact/industrial-project-workspace.png">
  <SiteHeader />
  <main class="inner-page contact-page">
    <section class="page-hero page-hero-visualized"><img class="page-hero-bg" src="/images/generated/contact/industrial-project-workspace.png" alt="Concept visualization of an industrial project-planning workspace" width="1536" height="1024" fetchpriority="high" decoding="async" /><div class="container"><p class="eyebrow">Start a project</p><h1>Bring the problem. We’ll start with the work.</h1><p class="lede">Tell us what needs to move, improve, repeat, connect, cut, hold, weld, automate, or become a complete system.</p><p class="concept-badge">Concept visualization · temporary presentation image</p></div></section>
    <section class="section"><div class="container contact-layout"><div class="contact-copy"><p class="eyebrow">Project fit</p><h2>Built for serious manufacturing problems.</h2><p>LaserX Design is a strong fit for custom equipment, autonomous systems, production fixtures, CAD-to-floor implementation, controls integration, CNC machinery, prototypes, and difficult fabrication work.</p><div class="contact-list"><span>Muskegon, Michigan</span><span>Serving West Michigan and select remote projects</span><a href="mailto:hello@laserxdesign.com">hello@laserxdesign.com</a></div><figure class="contact-support-visual"><img src="/images/capabilities/controls/machine-integration.png" alt="Machine controls and integration panel" loading="lazy" decoding="async" /><figcaption><span>Design · controls · fabrication</span><strong>Share the current process, the bottleneck, and the result you need.</strong></figcaption></figure></div><form class="project-form" id="project-form"><label>Name<input name="name" autocomplete="name" required /></label><label>Company<input name="company" autocomplete="organization" /></label><label>Email<input name="email" type="email" autocomplete="email" required /></label><label>Phone<input name="phone" type="tel" autocomplete="tel" /></label><label class="full">Project type<select name="project_type" required><option value="">Choose one</option><option>Autonomous system</option><option>Custom machine</option><option>Controls & integration</option><option>CAD & engineering</option><option>Fixture & tooling</option><option>CNC cutting & fabrication</option><option>Other</option></select></label><label>Target timeline<select name="timeline"><option>Exploring options</option><option>Within 30 days</option><option>1–3 months</option><option>3–6 months</option><option>6+ months</option></select></label><label>Estimated scope<select name="scope"><option>Not sure yet</option><option>Small part or fixture</option><option>Engineering package</option><option>Machine subsystem</option><option>Complete machine or system</option></select></label><label class="full">What needs to be solved?<textarea name="project_details" required placeholder="Describe the current process, pain point, desired result, and any known constraints."></textarea></label><label class="full">Drawing or reference files<input name="attachments" type="file" accept=".pdf,.dxf,.dwg,.step,.stp,.sldprt,.sldasm,.jpg,.jpeg,.png" multiple /></label><p class="form-note full">Your email app will open with the project details filled in. Attach the selected drawings or photos to that email before sending.</p><button class="button button-primary" type="submit">Prepare project inquiry ↗</button></form></div></section>
  </main>
  <script is:inline>
    document.querySelector('#project-form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const data = new FormData(form);
      const subject = `LaserX Design project inquiry — ${data.get('project_type') || 'New project'}`;
      const body = [
        `Name: ${data.get('name') || ''}`,
        `Company: ${data.get('company') || ''}`,
        `Email: ${data.get('email') || ''}`,
        `Phone: ${data.get('phone') || ''}`,
        `Project type: ${data.get('project_type') || ''}`,
        `Timeline: ${data.get('timeline') || ''}`,
        `Estimated scope: ${data.get('scope') || ''}`,
        '',
        'Project details:',
        `${data.get('project_details') || ''}`,
        '',
        'Please attach any selected drawings or reference photos before sending.'
      ].join('\n');
      window.location.href = `mailto:hello@laserxdesign.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</BaseLayout>
