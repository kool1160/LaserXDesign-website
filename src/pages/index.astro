---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  ['01', 'CAD & Product Design', 'SolidWorks, AutoCAD, and manufacturing-minded design for parts, assemblies, fixtures, equipment, and complete machines.'],
  ['02', 'CNC Plasma Cutting', 'Accurate CAD-driven cutting for custom parts, brackets, signs, prototypes, fixtures, and fabricated assemblies.'],
  ['03', 'Machine Design & Automation', 'Mechanical design, fabrication, machine wiring, controls, sensors, automation, and complete equipment development.'],
];
---

<BaseLayout>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="#top" aria-label="LaserX Design home">
        <span class="brand-mark">X</span>
        <span>LASERX DESIGN</span>
      </a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#services">Services</a>
        <a href="#work">Projects</a>
        <a href="/about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container hero-content">
        <p class="eyebrow">Muskegon · West Michigan</p>
        <h1>Design it. Build it. Make it work.</h1>
        <p class="lede">LaserX Design brings CAD, CNC plasma cutting, fabrication, machine wiring, automation, and hands-on manufacturing experience together—from the first concept through a finished part, fixture, or complete machine.</p>
        <div class="actions">
          <a class="button button-primary" href="#contact">Start a project</a>
          <a class="button button-secondary" href="#work">View our work</a>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="services">
      <div class="container">
        <div class="section-title">
          <p class="eyebrow">Capabilities</p>
          <h2>More than cutting and welding.</h2>
          <p>LaserX Design is a design-and-build company focused on practical manufacturing solutions, custom equipment, CNC work, automation, and metal fabrication.</p>
        </div>
        <div class="grid">
          {services.map(([number, title, description]) => (
            <article class="card">
              <span class="card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="container">
        <div class="section-title">
          <p class="eyebrow">Selected work</p>
          <h2>From CAD model to working machine.</h2>
          <p>This project gallery will document real LaserX Design work with original photos, design details, materials, manufacturing processes, and finished results.</p>
        </div>
        <div class="grid">
          <article class="card"><span class="card-number">Project 01</span><h3>Custom CNC plasma table</h3><p>Designed, fabricated, wired, assembled, tested, and developed as a complete cutting system with an automated water table.</p></article>
          <article class="card"><span class="card-number">Project 02</span><h3>Automated equipment</h3><p>Machine frames, mechanisms, controls, sensors, wiring, cobot integration, and practical automation designed around the process.</p></article>
          <article class="card"><span class="card-number">Project 03</span><h3>Fixtures and manufacturing systems</h3><p>Repeatable workholding, poka-yoke concepts, prototypes, routings, and shop-floor improvements built to control variation.</p></article>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="about">
      <div class="container section-title">
        <p class="eyebrow">About LaserX Design</p>
        <h2>Design experience rooted in manufacturing.</h2>
        <p>LaserX Design combines engineering software with hands-on experience in welding, fabrication, machine building, controls, wiring, CNC cutting, and production problem solving.</p>
        <div class="actions">
          <a class="button button-secondary" href="/about">Read the full story</a>
        </div>
      </div>
    </section>

    <section class="cta" id="contact">
      <div class="container">
        <p class="eyebrow">Have a part, machine, or process in mind?</p>
        <h2>Let’s design the right way to build it.</h2>
        <p>Contact details and the production quote form will be connected during the next build phase.</p>
        <div class="actions" style="justify-content:center">
          <a class="button button-primary" href="mailto:hello@laserxdesign.com">Request a quote</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">© {new Date().getFullYear()} LaserX Design. Muskegon, Michigan.</div>
  </footer>
</BaseLayout>
