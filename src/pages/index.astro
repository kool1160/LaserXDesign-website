---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-v2.css';
import '../styles/image-elements.css';

const process = [
  ['Discover', 'Define the problem, constraints, interfaces, risk, and measurable outcome.'],
  ['Engineer', 'Develop the mechanical, electrical, controls, fabrication, and integration plan as one system.'],
  ['Build', 'Cut, fabricate, wire, assemble, test, and document the complete solution.'],
  ['Integrate', 'Connect, commission, prove, refine, and prepare the system for production.']
];
---

<BaseLayout title="LaserX Design | Engineering Autonomous Systems" description="LaserX Design turns manufacturing problems into complete working systems through machine design, automation, controls, CAD, precision fabrication, and integration.">
  <div class="lx-home">
    <header class="lx-header">
      <div class="lx-shell lx-nav">
        <a class="lx-brand" href="#top" aria-label="LaserX Design home">
          <span class="lx-brandmark" aria-hidden="true">X</span>
          <span class="lx-wordmark"><strong>LASERX</strong><small>DESIGN</small></span>
        </a>
        <nav class="lx-navlinks" aria-label="Primary navigation">
          <a href="#work">Work</a>
          <a href="#process">Process</a>
          <a href="/projects">Projects</a>
          <a href="/engineering">Engineering</a>
          <a href="/about">About</a>
        </nav>
        <a class="lx-navcta" href="/contact">Start a project</a>
        <details class="lx-mobilemenu">
          <summary aria-label="Open navigation"><span></span></summary>
          <nav class="lx-mobilepanel" aria-label="Mobile navigation">
            <a href="#work">Selected work</a>
            <a href="#process">Our process</a>
            <a href="/projects">Projects</a>
            <a href="/engineering">Engineering</a>
            <a href="/about">About</a>
            <a href="/contact">Start a project</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <section class="lx-hero">
        <img class="lx-hero-media" src="/images/hero/laserx-home-hero.png" alt="LaserX Design CNC plasma system in an industrial workshop" width="1536" height="1024" fetchpriority="high" decoding="async" />
        <div class="lx-shell lx-heroinner">
          <p class="lx-kicker">Design · Build · Integrate · Automate</p>
          <h1 class="lx-title">Engineering autonomous systems.</h1>
          <p class="lx-copy">Complete industrial solutions—from CAD and controls through cutting, fabrication, wiring, integration, and commissioning.</p>
          <div class="lx-actions">
            <a class="lx-btn lx-btn-primary" href="/contact">Start a project ↗</a>
            <a class="lx-btn" href="#work">Explore the work</a>
          </div>
          <div class="lx-disciplines" aria-label="Core disciplines">
            <span>Machine design</span><span>Automation</span><span>Controls</span><span>Fabrication</span>
          </div>
        </div>
      </section>

      <section class="lx-intro reveal">
        <div class="lx-shell lx-introgrid">
          <p class="lx-sectionlabel">What we build</p>
          <div>
            <h2>Not another fabrication shop.<em>A complete design-and-build partner.</em></h2>
            <p>Mechanics, controls, fabrication, wiring, software interfaces, and operator workflow are engineered as one connected system.</p>
          </div>
        </div>
      </section>

      <section class="lx-showcase reveal" id="work">
        <div class="lx-shell">
          <div class="lx-showcasehead">
            <div><p class="lx-sectionlabel">Selected engineering</p><h2>Idea to implementation.</h2></div>
            <p>Real machines, tooling, controls, and manufacturing systems carried from the first model through the shop floor.</p>
          </div>
          <div class="lx-gallery">
            <a class="lx-card" href="/projects/cnc-plasma-table" aria-label="View X Series 1 CNC plasma table project">
              <img class="lx-card-image" src="/images/projects/x-series-1/x-series-feature.png" alt="X Series 1 CNC plasma table" width="1536" height="1024" loading="lazy" decoding="async" />
              <div class="lx-cardmeta"><span class="lx-cardnum">01 / FLAGSHIP SYSTEM</span><h3>X Series 1 CNC Plasma Table</h3><p>Mechanical design, motion, water table, controls, wiring, fabrication, assembly, and software—one complete machine.</p></div>
            </a>
            <a class="lx-card" href="/projects" aria-label="View fixture system projects">
              <img class="lx-card-image" src="/images/capabilities/fixtures/fixture-systems.png" alt="Production fixture engineering" width="1536" height="1024" loading="lazy" decoding="async" />
              <div class="lx-cardmeta"><span class="lx-cardnum">02 / PRODUCTION ENGINEERING</span><h3>Fixture Systems</h3><p>CAD-designed tooling for repeatability, access, dimensional control, and production flow.</p></div>
            </a>
            <a class="lx-card" href="/projects/robotic-welding" aria-label="Explore robotic welding and fixture integration">
              <img class="lx-card-image" src="/images/projects/robotic-welding/generated/robotic-welding-cleaned-01.png" alt="Robotic welding cell and production fixture" width="1536" height="2048" loading="lazy" decoding="async" />
              <div class="lx-cardmeta"><span class="lx-cardnum">03 / ROBOTIC WELDING</span><h3>Robotic Welding Systems</h3><p>Fixture engineering, robot access, weld sequencing, production flow, and cell integration developed as one system.</p></div>
            </a>
          </div>
        </div>
      </section>

      <section class="lx-story reveal">
        <div class="lx-shell lx-storygrid">
          <div class="lx-storycopy">
            <p class="lx-sectionlabel">Flagship project / X Series 1</p>
            <h2>CAD became a working machine.</h2>
            <p>The plasma table proves the full path: structure, gantry, motion, water table, controls, wiring, fabrication, finishing, and software development.</p>
            <div class="lx-sequence"><span>CAD</span><span>Build</span><span>Wire</span><span>Run</span></div>
          </div>
          <a class="lx-machine" href="/projects/cnc-plasma-table" aria-label="View the X Series 1 CNC plasma table case study">
            <img class="lx-machine-image" src="/images/projects/x-series-1/cad-to-machine.png" alt="CAD-to-machine development of the X Series CNC plasma table" width="1536" height="1024" loading="lazy" decoding="async" />
          </a>
        </div>
      </section>

      <section class="lx-process reveal" id="process">
        <div class="lx-shell">
          <div class="lx-processhead">
            <div>
              <p class="lx-sectionlabel">From idea to implementation</p>
              <h2>One system. One owner. Clear responsibility.</h2>
            </div>
            <p>The X Series 1 shows the complete path—from the first CAD model through controls, fabrication, assembly, and a commissioned working machine.</p>
          </div>
          <a class="lx-processfeature" href="/projects/cnc-plasma-table" aria-label="View the X Series 1 full process case study">
            <img class="lx-processimage" src="/images/our-process/x-series-1/x-series-1-process-hero.png" alt="X Series 1 CNC plasma table with CAD model, control panel, and production fixture" width="1536" height="1024" loading="lazy" decoding="async" />
            <span class="lx-processshade" aria-hidden="true"></span>
            <div class="lx-processcaption">
              <span>Our Process / X Series 1</span>
              <strong>CAD, controls, fabrication, and commissioning—one complete system.</strong>
              <em>View the case study ↗</em>
            </div>
          </a>
          <div class="lx-processgrid">
            {process.map(([title, description], index) => (
              <article class="lx-step"><span>0{index + 1}</span><h3>{title}</h3><p>{description}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section class="lx-proof reveal">
        <div class="lx-shell lx-proofgrid">
          <div class="lx-proofitem"><strong>200K+</strong><span>parts produced through proven fixture systems</span></div>
          <div class="lx-proofitem"><strong>8×</strong><span>documented production-output improvement</span></div>
          <div class="lx-proofitem"><strong>0.030 in</strong><span>critical fabrication tolerance verified</span></div>
          <div class="lx-proofitem"><strong>CAD → floor</strong><span>design carried through implementation</span></div>
        </div>
      </section>

      <section class="lx-final reveal" id="contact">
        <div class="lx-shell">
          <p class="lx-sectionlabel">Have a machine, process, or manufacturing problem?</p>
          <h2>Build what the process actually needs.</h2>
          <p>Bring the bottleneck, manual process, damaged machine, custom-equipment idea, or impossible part.</p>
          <div class="lx-actions"><a class="lx-btn lx-btn-primary" href="/contact">Start a project ↗</a></div>
        </div>
      </section>
    </main>

    <footer class="lx-footer">
      <div class="lx-shell lx-footergrid">
        <div><strong>LASERX DESIGN</strong><p>Autonomous systems · Design · Fabrication · Integration</p></div>
        <div>Muskegon, Michigan<br />Serving West Michigan and beyond</div>
        <div>© {new Date().getFullYear()} LaserX Design</div>
      </div>
    </footer>
  </div>

  <script is:inline>
    const menu = document.querySelector('.lx-mobilemenu');
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.removeAttribute('open')));
    const items = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      items.forEach((item) => observer.observe(item));
    } else {
      items.forEach((item) => item.classList.add('is-visible'));
    }
  </script>
</BaseLayout>
