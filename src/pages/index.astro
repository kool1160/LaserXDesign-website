---
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = [
  {
    number: '01',
    title: 'Autonomous systems',
    description: 'Purpose-built equipment and connected manufacturing systems designed to sense, decide, move, and perform repeatable work.'
  },
  {
    number: '02',
    title: 'Machine design & automation',
    description: 'Mechanical design, motion, sensors, controls, guarding, workflow, and operator interaction developed as one complete machine.'
  },
  {
    number: '03',
    title: 'Controls & integration',
    description: 'Machine wiring, devices, networking, controls, testing, commissioning, and integration with the systems already on your floor.'
  },
  {
    number: '04',
    title: 'CAD & manufacturing design',
    description: 'SolidWorks and AutoCAD development for equipment, fixtures, parts, assemblies, prototypes, and production-ready documentation.'
  },
  {
    number: '05',
    title: 'Precision cutting',
    description: 'CNC plasma and laser-ready design for brackets, components, fixtures, prototypes, replacement parts, and complete cut assemblies.'
  },
  {
    number: '06',
    title: 'TIG & MIG fabrication',
    description: 'Steel, stainless, and aluminum fabrication backed by fixture thinking, dimensional control, and real production experience.'
  }
];

const process = [
  ['Discover', 'Define the work, constraints, risk, interfaces, and measurable outcome.'],
  ['Engineer', 'Develop the mechanical, electrical, controls, fabrication, and integration plan.'],
  ['Build', 'Cut, machine, fabricate, wire, assemble, and document the complete system.'],
  ['Integrate', 'Install, connect, test, prove, refine, and prepare the system for real production.']
];
---

<BaseLayout title="LaserX Design | Autonomous Industrial Systems">
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="#top" aria-label="LaserX Design home">
        <span class="brand-mark" aria-hidden="true">X</span>
        <span class="brand-copy"><strong>LASERX</strong><small>DESIGN</small></span>
      </a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#solutions">Solutions</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#projects">Projects</a>
        <a href="/about">About</a>
        <a class="nav-cta" href="#contact">Start a project</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container hero-layout">
        <div class="hero-content">
          <p class="eyebrow">Design · Build · Integrate · Automate</p>
          <h1>Engineering autonomous manufacturing systems.</h1>
          <p class="lede">LaserX Design develops complete industrial solutions—from CAD, controls, and machine wiring through precision cutting, fabrication, integration, and commissioning.</p>
          <div class="actions">
            <a class="button button-primary" href="#contact">Start a project <span>↗</span></a>
            <a class="button button-secondary" href="#projects">Explore our work</a>
          </div>
          <div class="hero-proof" aria-label="Core disciplines">
            <span>Autonomous systems</span>
            <span>Machine design</span>
            <span>Controls</span>
            <span>Fabrication</span>
          </div>
        </div>
        <aside class="hero-panel" aria-label="LaserX Design system scope">
          <p class="panel-label">Complete system scope</p>
          <div class="system-stack">
            <span>01 / Mechanical</span>
            <span>02 / Electrical</span>
            <span>03 / Controls</span>
            <span>04 / Fabrication</span>
            <span>05 / Integration</span>
          </div>
          <div class="panel-status"><i></i> Built for production</div>
        </aside>
      </div>
      <a class="scroll-cue" href="#solutions" aria-label="Scroll to solutions">Scroll <span>↓</span></a>
    </section>

    <section class="statement" id="solutions">
      <div class="container statement-grid">
        <p class="eyebrow">What we build</p>
        <div>
          <h2>Not another fabrication shop.<br /><em>A complete design-and-build partner.</em></h2>
          <p>We solve manufacturing problems by treating mechanics, controls, fabrication, wiring, software interfaces, and people as parts of one system. The result is equipment that is practical to operate, maintain, and improve.</p>
        </div>
      </div>
    </section>

    <section class="section capabilities" id="capabilities">
      <div class="container">
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">Capabilities</p>
            <h2>From first sketch to proven system.</h2>
          </div>
          <p>One coordinated path from idea through production—without handing the project between disconnected vendors.</p>
        </div>
        <div class="capability-grid">
          {capabilities.map((item) => (
            <article class="capability-card">
              <span class="card-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="card-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="featured-project" id="projects">
      <div class="container project-layout">
        <div class="project-copy">
          <p class="eyebrow">Flagship project / X Series 1</p>
          <h2>A complete CNC plasma system—designed and built from the ground up.</h2>
          <p>Mechanical structure, water table, gantry, motion, wiring, controls, CAD, fabrication, assembly, finishing, and ongoing software development brought together as one working machine.</p>
          <dl class="project-specs">
            <div><dt>Scope</dt><dd>Full-system design & build</dd></div>
            <div><dt>Platform</dt><dd>4 × 8 CNC plasma</dd></div>
            <div><dt>Disciplines</dt><dd>CAD · Fabrication · Wiring · Controls</dd></div>
          </dl>
          <a class="text-link" href="/projects/cnc-plasma-table">View the case study <span>↗</span></a>
        </div>
        <div class="project-visual">
          <div class="project-image" role="img" aria-label="LaserX Design CNC plasma table"></div>
          <div class="project-tag">Designed / Fabricated / Wired / Integrated</div>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">How we work</p>
            <h2>One system. One owner. Clear responsibility.</h2>
          </div>
        </div>
        <div class="process-grid">
          {process.map(([title, description], index) => (
            <article class="process-step">
              <span>0{index + 1}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="proof-band">
      <div class="container proof-grid">
        <div><strong>200K+</strong><span>parts produced through proven fixture systems</span></div>
        <div><strong>8×</strong><span>documented production-output improvement</span></div>
        <div><strong>0.030 in</strong><span>critical fabrication tolerance verified</span></div>
        <div><strong>CAD → floor</strong><span>design carried through implementation</span></div>
      </div>
    </section>

    <section class="about-preview">
      <div class="container about-grid">
        <p class="eyebrow">About LaserX Design</p>
        <div>
          <h2>Engineering informed by the reality of the shop floor.</h2>
          <p>LaserX Design is built on hands-on experience across welding, fabrication, fixtures, CAD, cobot implementation, machine wiring, controls, networking, production improvement, and complete equipment builds. We design for the people who have to run it, maintain it, and depend on it.</p>
          <a class="text-link" href="/about">Meet the builder behind the systems <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="cta" id="contact">
      <div class="container cta-inner">
        <p class="eyebrow">Have a system, machine, or manufacturing problem?</p>
        <h2>Let’s build what the process actually needs.</h2>
        <p>Bring the idea, bottleneck, damaged machine, manual process, or impossible part. We’ll start by understanding the work.</p>
        <div class="actions">
          <a class="button button-primary" href="mailto:hello@laserxdesign.com">Start a conversation <span>↗</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-grid">
      <div><strong>LASERX DESIGN</strong><p>Autonomous systems · Design · Fabrication · Integration</p></div>
      <div><span>Muskegon, Michigan</span><span>Serving West Michigan and beyond</span></div>
      <div>© {new Date().getFullYear()} LaserX Design</div>
    </div>
  </footer>
</BaseLayout>
