---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
const projects = [
  ['01', 'X Series 1 CNC Plasma Table', 'Complete 4 × 8 CNC plasma system covering mechanical design, CAD, fabrication, water table, gantry, wiring, motion control, assembly, integration, and ongoing software development.', '/projects/cnc-plasma-table', '/images/projects/x-series-1/x-series-feature.png', 'X Series 1 CNC plasma table'],
  ['02', 'Production Fixture Systems', 'CAD-to-floor fixture development focused on alignment, repeatability, operator access, weld sequence, dimensional control, and scalable production output.', '/contact', '/images/capabilities/fixtures/fixture-systems.png', 'Production fixture system'],
  ['03', 'Robotic Welding & Cobot Integration', 'Fixture tables, robot placement, access studies, workflow planning, sensing, and production-cell concepts developed around real manufacturing work.', '/projects/robotic-welding', '/images/projects/robotic-welding/generated/robotic-welding-cleaned-01.png', 'Robotic welding cell and production fixture'],
  ['04', 'Hydraulic Assembly Fixtures', 'Controlled holding and alignment for cylinder fit-up, structural components, repeatable geometry, and production-ready fabrication.', '/contact', '/images/generated/projects/integrated-manufacturing-workshop.png', 'Concept visualization of an integrated manufacturing workshop'],
  ['05', 'Custom Fabrication & Machine Components', 'Large assemblies, formed parts, aluminum and stainless work, prototypes, replacement components, and precision production builds.', '/contact', '/images/hero/laserx-home-hero.png', 'LaserX Design cutting and fabrication work']
];
---
<BaseLayout title="Projects | LaserX Design" description="Explore LaserX Design projects in autonomous systems, CNC machinery, production fixtures, robotics, controls, and custom manufacturing equipment." image="/images/generated/projects/integrated-manufacturing-workshop.png">
  <SiteHeader />
  <main class="inner-page">
    <section class="page-hero page-hero-visualized"><img class="page-hero-bg" src="/images/generated/projects/integrated-manufacturing-workshop.png" alt="Concept visualization of a modern integrated manufacturing workshop" width="1536" height="1024" fetchpriority="high" decoding="async" /><div class="container"><p class="eyebrow">Selected work</p><h1>Proof from concept through production.</h1><p class="lede">Projects are presented as systems—not photo dumps—showing the problem, engineering decisions, build process, integration, and production result.</p><p class="concept-badge">Concept visualization · temporary page imagery</p></div></section>
    <section class="section"><div class="container"><div class="project-index visual-project-index">{projects.map(([number, title, description, href, image, alt]) => <a class="project-row" href={href}><span class="project-number">{number}</span><div class="project-row-thumb"><img src={image} alt={alt} loading="lazy" decoding="async" /></div><div><h2>{title}</h2><p>{description}</p></div><span class="project-arrow">↗</span></a>)}</div></div></section>
    <section class="cta"><div class="container cta-inner"><p class="eyebrow">Have a problem worth solving?</p><h2>Your project could be next.</h2><a class="button button-primary" href="/contact">Start a project ↗</a></div></section>
  </main>
</BaseLayout>
