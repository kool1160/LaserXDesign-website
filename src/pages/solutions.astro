---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const solutions = [
  ['Autonomous manufacturing systems', 'Purpose-built equipment that combines mechanics, sensing, motion, controls, and software into one production-ready system.'],
  ['Custom machine design', 'Complete machine architecture developed around the actual process, operator, maintenance needs, floor space, and output target.'],
  ['Industrial automation', 'Cobot and robotic work cells, automated fixtures, material handling, sensors, safety, workflow, and production integration.'],
  ['Controls & system integration', 'Electrical layout, machine wiring, motion control, devices, networking, HMI concepts, testing, and commissioning.'],
  ['Production fixturing', 'Fixture systems engineered for repeatability, access, alignment, quality control, and scalable production output.'],
  ['Process improvement', 'Practical redesign of manual, inconsistent, or inefficient work using better tooling, controls, information, and automation.']
];
---
<BaseLayout title="Autonomous Manufacturing Solutions | LaserX Design" description="LaserX Design develops autonomous systems, custom machines, controls, fixtures, automation, and integrated manufacturing solutions." image="/images/generated/solutions/autonomous-manufacturing-system.png">
  <SiteHeader />
  <main class="inner-page">
    <section class="page-hero page-hero-visualized">
      <img class="page-hero-bg" src="/images/generated/solutions/autonomous-manufacturing-system.png" alt="Concept visualization of an integrated autonomous manufacturing system" width="1536" height="1024" fetchpriority="high" decoding="async" />
      <div class="container"><p class="eyebrow">Solutions</p><h1>Manufacturing systems engineered around the work.</h1><p class="lede">LaserX Design brings mechanical design, fabrication, controls, wiring, automation, and integration together under one accountable build path.</p><p class="concept-badge">Concept visualization · temporary presentation image</p></div>
    </section>
    <section class="section"><div class="container"><div class="capability-grid">{solutions.map(([title, description], index) => <article class="capability-card"><span class="card-number">0{index + 1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
    <section class="visual-strip-section"><div class="container"><div class="visual-strip-head"><div><p class="eyebrow">System layers</p><h2>Mechanics, tooling, and controls developed together.</h2></div><p>These three layers show how the work moves from machine structure through production workholding and into the controls that make the system operate.</p></div><div class="visual-strip"><a class="visual-tile" href="/projects/cnc-plasma-table"><img src="/images/projects/x-series-1/x-series-feature.png" alt="X Series 1 CNC plasma table" loading="lazy" decoding="async" /><div><span>Machine design</span><strong>Complete equipment built around the process.</strong></div></a><a class="visual-tile" href="/projects"><img src="/images/capabilities/fixtures/fixture-systems.png" alt="Production fixture system" loading="lazy" decoding="async" /><div><span>Fixture systems</span><strong>Repeatable location, access, and production flow.</strong></div></a><a class="visual-tile" href="/engineering"><img src="/images/capabilities/controls/machine-integration.png" alt="Machine controls and integration" loading="lazy" decoding="async" /><div><span>Controls integration</span><strong>Motion, devices, wiring, sensing, and commissioning.</strong></div></a></div></div></section>
    <section class="statement"><div class="container statement-grid"><p class="eyebrow">The difference</p><div><h2>One system. One owner. <em>No disconnected handoffs.</em></h2><p>Projects are developed as complete systems so the structure, controls, tooling, fabrication, electrical architecture, and production workflow support each other from the beginning.</p></div></div></section>
    <section class="cta"><div class="container cta-inner"><p class="eyebrow">Bring us the bottleneck</p><h2>Let’s engineer the right solution.</h2><a class="button button-primary" href="/contact">Start a project ↗</a></div></section>
  </main>
</BaseLayout>
